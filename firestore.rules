rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'joyk1838@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBrand(data) {
      return data.keys().hasAll(['name', 'image', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.image is string && data.image.size() > 0 && data.image.size() <= 350000 &&
             data.order is number;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll(['name', 'role', 'order']) &&
             data.keys().hasOnly(['id', 'name', 'role', 'bio', 'image', 'badges', 'initials', 'email', 'linkedin', 'twitter', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 120 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 350000)) &&
             (!('badges' in data) || (data.badges is list && data.badges.size() <= 10 && (data.badges.size() == 0 || data.badges[0] is string))) &&
             (!('initials' in data) || (data.initials is string && data.initials.size() <= 16)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('linkedin' in data) || (data.linkedin is string && data.linkedin.size() <= 500)) &&
             (!('twitter' in data) || (data.twitter is string && data.twitter.size() <= 500)) &&
             data.order is number;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['url', 'title', 'uploadedAt']) &&
             data.url is string && data.url.size() > 0 && data.url.size() <= 350000 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120;
    }

    function isValidTimeline(data) {
      return data.keys().hasAll(['year', 'title', 'status', 'order']) &&
             data.year is string &&
             data.title is string &&
             data.status is string &&
             data.order is number;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['title', 'completed', 'order']) &&
             data.title is string &&
             data.completed is bool &&
             data.order is number;
    }

    function isValidGrowth(data) {
      return data.keys().hasAll(['month', 'amount']) &&
             data.month is string &&
             data.amount is number;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBrand(request.resource.data);
      allow delete: if isAdmin();
    }

    match /team/{memberId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(memberId) && isValidTeamMember(request.resource.data);
      allow delete: if isAdmin() && isValidId(memberId);
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /timeline/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTimeline(request.resource.data);
      allow delete: if isAdmin();
    }

    match /milestones/{milestoneId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMilestone(request.resource.data);
      allow delete: if isAdmin();
    }

    match /growth/{growthId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGrowth(request.resource.data);
      allow delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
