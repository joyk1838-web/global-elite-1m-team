{
  "entities": {
    "Brand": {
      "title": "Brand",
      "description": "Core brands and ventures of Elite Group",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "desc": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "image", "order"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Leadership and team member profiles of Elite Group",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "image": { "type": "string" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "initials": { "type": "string" },
        "email": { "type": "string" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "role", "order"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Corporate archive photography and highlights",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "title", "uploadedAt"]
    },
    "TimelineEvent": {
      "title": "Timeline Event",
      "description": "Strategic roadmap milestones for Elite Group",
      "type": "object",
      "properties": {
        "year": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "icon": { "type": "string" },
        "status": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["year", "title", "status", "order"]
    },
    "Milestone": {
      "title": "Milestone",
      "description": "Operational milestone items for progress tracking",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "completed", "order"]
    },
    "GrowthPoint": {
      "title": "Growth Point",
      "description": "Monthly revenue and growth trajectory entries",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "amount": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["month", "amount"]
    },
    "SiteConfig": {
      "title": "Site Config",
      "description": "Global company identity, hero content, MD profile, metrics, and contact details",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "tagline": { "type": "string" },
        "heroEyebrow": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "mission": { "type": "string" },
        "vision": { "type": "string" },
        "mdName": { "type": "string" },
        "mdRole": { "type": "string" },
        "mdImage": { "type": "string" },
        "mdQuote": { "type": "string" },
        "mdBannerQuote": { "type": "string" },
        "totalRevenue": { "type": "string" },
        "netWorth": { "type": "string" },
        "multiplier": { "type": "string" },
        "status": { "type": "string" },
        "activeUnits": { "type": "string" },
        "valuationTarget": { "type": "string" },
        "contactEmail": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "twitterUrl": { "type": "string" },
        "instagramUrl": { "type": "string" }
      },
      "required": ["companyName", "mission"]
    }
  },
  "firestore": {
    "brands": {
      "schema": "Brand",
      "description": "Collection of corporate brands"
    },
    "team": {
      "schema": "TeamMember",
      "description": "Leadership team members"
    },
    "gallery": {
      "schema": "GalleryItem",
      "description": "Corporate gallery items"
    },
    "timeline": {
      "schema": "TimelineEvent",
      "description": "Chronological roadmap events"
    },
    "milestones": {
      "schema": "Milestone",
      "description": "Mission milestones"
    },
    "growth": {
      "schema": "GrowthPoint",
      "description": "Growth points and revenue charts"
    },
    "config": {
      "schema": "SiteConfig",
      "description": "Global platform configurations"
    }
  }
}
