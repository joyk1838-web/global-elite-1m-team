# ==============================================================================
# Global-elite-1m-team (ELITE GROUP) Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development, or add these keys in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side AI Strategist (Required for live Gemini AI responses)
# ------------------------------------------------------------------------------
# Do NOT prefix with VITE_ so this key stays strictly server-side in /api/chat.
# Where to get it: Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Application URL (Optional - used for server references & callbacks)
# ------------------------------------------------------------------------------
# Where to get it: Your Vercel production domain (e.g., https://global-elite-1m-team.vercel.app)
APP_URL="https://global-elite-1m-team.vercel.app"

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (Optional Override)
# ------------------------------------------------------------------------------
# Note: The app is already pre-configured via `firebase-applet-config.json`.
# Set these VITE_FIREBASE_* variables ONLY if you want to connect your Vercel
# deployment to a separate Firebase project without editing JSON files.
# Where to get them: Firebase Console -> Project Settings -> General -> Your apps -> Web SDK
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
